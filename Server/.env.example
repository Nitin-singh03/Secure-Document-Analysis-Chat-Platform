# Server runtime
PORT=4000
# MongoDB Atlas connection string
MONGO_URI=
# Frontend origin URL for CORS and OAuth redirects
CLIENT=http://localhost:5173
# Public Server base URL for OAuth callbacks
SERVER_URI=http://localhost:4000
# Runtime environment (development | production)
NODE_ENV=development

# JWT signing secrets
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=

# SMTP credentials for OTP and transactional emails
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=

# Google OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Gemini API key and generation model
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Versioned RAG pipeline overrides
INGEST_VERSION=v0
RETRIEVAL_PROFILE=v0
PROMPT_VERSION=v0

# Client (Client/.env)
# Base URL of the API server used by Vite client
VITE_SERVER_URI=http://localhost:4000
